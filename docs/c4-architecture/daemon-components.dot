// C4 component model of the oll node daemon derived from production src/.
// Replica, sync, and plugin internals are expanded in their focused component
// diagrams.

digraph C4_Daemon_Components {
  graph [
    label="oll Node Daemon - C4 Component Diagram - Current Codebase",
    labelloc=t,
    labeljust=l,
    fontsize=20,
    fontname="Helvetica",
    bgcolor="white",
    pad=0.35,
    nodesep=0.7,
    ranksep=0.95,
    compound=true
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9.5, margin="0.17,0.11"];
  edge [fontname="Helvetica", fontsize=8, color="#555555", fontcolor="#333333", arrowsize=0.72];

  admin_client [
    label="Bounded oll Client\n[Container]\nIssues typed local administrative requests",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  peer_daemon [
    label="Peer oll Node Daemon\n[External Container Instance]",
    fillcolor="#999999",
    fontcolor="white",
    color="#666666"
  ];
  plugin_process [
    label="Spawned Plugin Process\n[External Container]\nTrusted foreground child using the oll-hosted runtime stream",
    fillcolor="#999999",
    fontcolor="white",
    color="#666666"
  ];
  deployment_state [
    shape=cylinder,
    label="Deployment State and Key Material\n[Container: File Store]\nconfig.lua/modules, plugins.lua, per-PluginId Lua/masks, identities,\nrun/node.lock/admin.sock, optional key file",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  working_tree [
    shape=cylinder,
    label="Working Tree\n[Container: File System]",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  sql_store [
    shape=cylinder,
    label="Replica and Deployment Store\n[Container: SQLite or PostgreSQL]\nReplica state plus peer bindings and plugin state/intents/jobs",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  logs [
    shape=cylinder,
    label="Structured Log Files\n[Container: File Store]\noll.log, sync.log, and plugin.log",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  snapshot [
    shape=cylinder,
    label="Replica Snapshot\n[Container: File]\n.ollsnap",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  plugin_data [
    shape=cylinder,
    label="Plugin Package Data\n[Container: File Store]\nPluginId-keyed generations/current/build logs",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  artifact_downloads [
    shape=cylinder,
    label="Plugin Artifact Downloads\n[Container: File Store]\nVerified no-replace outputs",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];

  subgraph cluster_daemon {
    label="oll Node Daemon [Container: Rust + Tokio]";
    labelloc=t;
    labeljust=l;
    fontsize=14;
    fontname="Helvetica";
    color="#438DD5";
    penwidth=2;
    style="rounded,dashed";
    margin=20;

    lifecycle [
      label="Node Lifecycle Orchestrator\n[Component]\nPreparedRunIntent, DeploymentLock, Unix signals, readiness pingback,\nand ordered construction/shutdown of replica, sync, and plugin runtimes.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    configuration [
      label="Configuration Runtime\n[Component]\nConfigRuntime::load -> ResolvedNodeConfig.\nEmbedded LuaJIT, controlled require/getenv/read_network_key,\nstrict schema conversion, topology and storage-layout validation.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    identities [
      label="Identity Coordinator and Watcher\n[Component]\nIdentityCoordinator + IdentityWatch.\nHot-reloads node.json and replica.json under a commit gate,\nupdates logger identity, and publishes invalidation epochs.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    admin_api [
      label="Admin API Adapter\n[Component]\nTyped oll.protocol.Admin unary RPCs over UDS.\nValidates trace context and adapts lifecycle, replica, sync,\nplugin package/process, release, and job operations.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    replica [
      label="Replica Runtime\n[Component]\nReplicaRuntime owns optional ActiveReplica state, recursive working-tree\nwatch/projection, typed document APIs, SQL persistence, snapshots,\nand the inventory/candidate APIs consumed by sync.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    sync [
      label="Peer Sync Runtime\n[Component]\nSyncRuntime owns listener/outbound tasks, Noise sessions, durable peer\nbindings, status/ping control, finite bidirectional rounds,\nand authenticated first-replica bootstrap.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    plugins [
      label="Plugin Runtime\n[Component]\nPluginRuntime owns package reconciliation/recovery, SQL desired state/jobs,\nprocess supervision, oll-hosted loopback gRPC sessions, live Lua calls,\nartifact publication, and plugin output ingestion.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    logger [
      label="Structured Logging Service\n[Component]\nNodeLogger open/emit/set_identity/set_filter/flush_until.\nNonblocking bounded enqueue, dynamic filters, correlation/routing,\ndedicated batching writer thread, and file sinks.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

  }

  admin_client -> admin_api [
    label="Calls lifecycle, replica, sync, plugin package/process, and job methods\n[gRPC over UDS]"
  ];

  lifecycle -> deployment_state [
    label="Acquires run lock and binds Admin socket\n[DeploymentLock / UnixListener]"
  ];
  lifecycle -> configuration [label="Loads and validates effective configuration"];
  configuration -> deployment_state [
    label="Evaluates config.lua/modules and optional key file\n[embedded LuaJIT + file I/O]"
  ];
  lifecycle -> identities [label="Creates coordinator and starts final-state watcher"];
  identities -> deployment_state [
    dir=both,
    label="Loads, watches, and atomically coordinates identity records\n[strict JSON + notify]"
  ];
  lifecycle -> logger [label="Opens sinks, emits lifecycle events, and requests deadline-bounded drain"];
  lifecycle -> replica [label="Starts before sync and drains during shutdown"];
  lifecycle -> sync [label="Starts after replica and drains before process exit"];
  lifecycle -> plugins [label="Starts after sync recovery and drains all plugin work by one deadline"];
  lifecycle -> admin_api [label="Constructs AdminState and serves UDS"];

  admin_api -> lifecycle [label="Requests ordered shutdown\n[ShutdownNotice]"];
  admin_api -> identities [label="Reads current hot NodeIdentity for status"];
  admin_api -> replica [label="Status, inspection, history, snapshot import/export"];
  admin_api -> sync [label="Peer status, synchronize, and ping"];
  admin_api -> plugins [label="Package, query, desired-state, restart, release, and job methods"];
  admin_api -> logger [label="Emits RPC events and changes live filters"];

  identities -> replica [
    dir=both,
    label="Coordinates NodeId/ReplicaId hot changes and commit serialization"
  ];
  identities -> logger [label="Replaces identity fields after valid node.json edits"];
  sync -> identities [
    label="Reads identity, holds bootstrap commit guard,\nand cancels sessions on epoch changes"
  ];
  sync -> replica [
    label="Binds peers; captures inventories; transfers and activates\nnormal/bootstrap candidates"
  ];
  plugins -> configuration [label="Evaluates live PluginId-owned Lua values/closures in the shared registry"];
  plugins -> identities [label="Uses the current NodeIdentity in instance handshakes"];
  plugins -> replica [label="Serves revision-guarded document/tree/CRDT host calls"];
  plugins -> sql_store [dir=both, label="Persists package state, desired state, jobs, and recovery intents"];
  plugins -> plugin_data [dir=both, label="Publishes and recovers PluginId-keyed package generations"];
  plugins -> artifact_downloads [label="Publishes verified job artifacts with no-replace semantics"];
  plugins -> plugin_process [label="Spawns/supervises process group; passes endpoint and stdin liveness"];
  plugin_process -> plugins [label="Opens PluginRuntime.Connect\n[plaintext loopback protobuf/gRPC bidi]"];
  plugins -> logger [label="Emits lifecycle/package/job events and ingests plugin output"];

  replica -> deployment_state [dir=both, label="Recovers and updates replica.json"];
  replica -> working_tree [dir=both, label="Watches, reconciles, and projects"];
  replica -> sql_store [dir=both, label="Persists generations, objects, blobs, and recovery state"];
  replica -> snapshot [dir=both, label="Stages, verifies, exports, and imports .ollsnap"];
  replica -> logger [label="Emits correlated replica/snapshot events"];

  sync -> peer_daemon [
    dir=both,
    label="Encrypted SyncEnvelope sessions\n[TCP + Noise NNpsk0]"
  ];
  sync -> logger [label="Emits correlated connection, round, and bootstrap events"];
  logger -> logs [label="Writer thread batches normalized JSON Lines and bounded flushes"];
}
