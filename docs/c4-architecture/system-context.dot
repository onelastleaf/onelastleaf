// C4 system-context model derived from the production code in src/.

digraph C4_System_Context {
  graph [
    label="onelastleaf (oll) - C4 System Context - Current Codebase",
    labelloc=t,
    labeljust=l,
    fontsize=20,
    fontname="Helvetica",
    bgcolor="white",
    pad=0.35,
    nodesep=1.0,
    ranksep=1.15
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.18,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333", arrowsize=0.8];

  deployment_user [
    label="Deployment User\n[Person]\nRuns oll, owns its configuration and identities,\nand edits the local working tree",
    fillcolor="#08427B",
    fontcolor="white",
    color="#052E56"
  ];

  oll [
    label="onelastleaf (oll)\n[Software System]\nA user-owned CRDT document library. Each deployment runs\none writable node with exactly one local replica slot.",
    fillcolor="#1168BD",
    fontcolor="white",
    color="#0B4884"
  ];

  peer_oll [
    label="Peer oll Deployment\n[External Instance of the Same Software System]\nAn equal writable node that either shares the ReplicaId\nor supplies the first authenticated bootstrap",
    fillcolor="#999999",
    fontcolor="white",
    color="#666666"
  ];

  plugin_process [
    label="Trusted Plugin Process\n[External Software System]\nA locally installed child implemented in any language;\nconnects back to the instance-owned oll gRPC endpoint",
    fillcolor="#999999",
    fontcolor="white",
    color="#666666"
  ];

  deployment_user -> oll [
    label="Initializes and operates the node; reads and edits documents;\ninstalls, controls, and invokes trusted plugins\n[CLI and local filesystem]"
  ];

  oll -> peer_oll [
    dir=both,
    label="Authenticates, pings, bootstraps, and exchanges\nfinite CRDT update/blob rounds\n[TCP + Noise NNpsk0 + prost SyncEnvelope]"
  ];

  oll -> plugin_process [
    dir=both,
    label="Installs, spawns, supervises, dispatches jobs, and serves\ndocument/config/artifact calls\n[child process + loopback protobuf/gRPC bidi stream]"
  ];
}
