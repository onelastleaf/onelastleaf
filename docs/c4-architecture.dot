// C4 model for the architecture currently implemented in src/.
//
// This DOT source contains four independent graphs so that every diagram stays
// at one C4 abstraction level. Graphviz can render each top-level digraph.
// Sync and plugin protobuf contracts and CLI syntax are intentionally absent:
// they do not yet have runtime components in the current implementation.

digraph C4_System_Context {
  graph [
    label="onelastleaf (oll) - C4 System Context - Current Implementation",
    labelloc=t,
    labeljust=l,
    fontsize=20,
    fontname="Helvetica",
    bgcolor="white",
    pad=0.35,
    nodesep=0.9,
    ranksep=1.1
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, margin="0.18,0.12"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", fontcolor="#333333", arrowsize=0.8];

  deployment_user [
    label="Deployment User\n[Person]\nRuns oll and edits the local document tree",
    fillcolor="#08427B",
    fontcolor="white",
    color="#052E56"
  ];

  oll [
    label="onelastleaf (oll)\n[Software System]\nA user-owned, offline document library with one daemon,\none node, and exactly one CRDT replica per deployment",
    fillcolor="#1168BD",
    fontcolor="white",
    color="#0B4884"
  ];

  deployment_user -> oll [
    label="Runs bounded commands or the daemon;\nreads and edits documents\n[CLI and local filesystem]"
  ];
}

digraph C4_Containers {
  graph [
    label="onelastleaf (oll) - C4 Container Diagram - Current Implementation",
    labelloc=t,
    labeljust=l,
    fontsize=20,
    fontname="Helvetica",
    bgcolor="white",
    pad=0.35,
    nodesep=0.75,
    ranksep=1.0,
    compound=true
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin="0.18,0.12"];
  edge [fontname="Helvetica", fontsize=8.5, color="#555555", fontcolor="#333333", arrowsize=0.75];

  user [
    label="Deployment User\n[Person]",
    fillcolor="#08427B",
    fontcolor="white",
    color="#052E56"
  ];

  subgraph cluster_oll_system {
    label="onelastleaf (oll) [Software System]";
    labelloc=t;
    labeljust=l;
    fontsize=14;
    fontname="Helvetica";
    color="#1168BD";
    penwidth=2;
    style="rounded,dashed";
    margin=22;

    bounded_client [
      label="Bounded oll Client\n[Container: Process]\nSame Rust executable; parses one command, performs\nlocal/bootstrap work or one Admin call, renders, and exits",
      fillcolor="#438DD5",
      fontcolor="white",
      color="#2E6295"
    ];

    node_daemon [
      label="oll Node Daemon\n[Container: Process]\nSame Rust executable with Tokio; owns lifecycle,\nAdmin UDS, one node, and exactly one replica",
      fillcolor="#438DD5",
      fontcolor="white",
      color="#2E6295"
    ];

    deployment_files [
      shape=cylinder,
      label="Deployment Files\n[Container: File Store]\nconfig.lua, node.json, node.lock",
      fillcolor="#438DD5",
      fontcolor="white",
      color="#2E6295"
    ];

    working_tree [
      shape=cylinder,
      label="Working Tree\n[Container: File System]\nUser-editable ordinary directories and files;\nprojection of the logical replica",
      fillcolor="#438DD5",
      fontcolor="white",
      color="#2E6295"
    ];

    replica_store [
      shape=cylinder,
      label="Replica Store\n[Container: SQL Data Store]\nSQLite or PostgreSQL; durable catalog/document CRDTs,\nblobs, operation history, and recovery state",
      fillcolor="#438DD5",
      fontcolor="white",
      color="#2E6295"
    ];

    log_files [
      shape=cylinder,
      label="Structured Log Files\n[Container: File Store]\noll.log and sync.log as user-owned JSON Lines",
      fillcolor="#438DD5",
      fontcolor="white",
      color="#2E6295"
    ];

    snapshot_archive [
      shape=cylinder,
      label="Replica Snapshot\n[Container: File]\n.ollsnap tar+zstd logical-replica checkpoint",
      fillcolor="#438DD5",
      fontcolor="white",
      color="#2E6295"
    ];
  }

  user -> bounded_client [label="Invokes commands\n[terminal / stdin / stdout / stderr]"];
  user -> node_daemon [label="May run in foreground\n[oll run]"];
  user -> deployment_files [label="Owns and may edit configuration and identity\n[Lua and JSON]"];
  user -> working_tree [label="Reads and edits documents\n[filesystem tools]"];

  bounded_client -> node_daemon [label="Administrative operations\n[typed protobuf/gRPC over Unix domain socket]"];
  bounded_client -> node_daemon [label="Starts detached daemon and verifies readiness\n[process spawn + one-use nonce pingback]", style=dashed];
  bounded_client -> deployment_files [label="Initializes deployment or locates Admin socket\n[filesystem]"];
  bounded_client -> snapshot_archive [label="Inspects or verifies locally\n[streaming file I/O]"];

  node_daemon -> deployment_files [label="Locks deployment; loads identity and configuration\n[flock, JSON, embedded LuaJIT]"];
  node_daemon -> working_tree [dir=both, label="Watches/reconciles edits and projects replica state\n[notify + filesystem I/O]"];
  node_daemon -> replica_store [dir=both, label="Persists and recovers authoritative replica state\n[SQL transactions via sqlx]"];
  node_daemon -> log_files [label="Appends normalized events asynchronously\n[JSON Lines]"];
  node_daemon -> snapshot_archive [dir=both, label="Exports or imports complete replica checkpoints\n[tar + zstd]"];
}

digraph C4_Daemon_Components {
  graph [
    label="oll Node Daemon - C4 Component Diagram - Current Implementation",
    labelloc=t,
    labeljust=l,
    fontsize=20,
    fontname="Helvetica",
    bgcolor="white",
    pad=0.35,
    nodesep=0.7,
    ranksep=0.95,
    compound=true
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9.5, margin="0.17,0.11"];
  edge [fontname="Helvetica", fontsize=8, color="#555555", fontcolor="#333333", arrowsize=0.72];

  admin_client [
    label="Bounded oll Client\n[Container]\nIssues typed administrative requests",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  deployment_files [
    shape=cylinder,
    label="Deployment Files\n[Container: File Store]\nconfig.lua, node.json, node.lock",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  working_tree [
    shape=cylinder,
    label="Working Tree\n[Container: File System]",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  sql_store [
    shape=cylinder,
    label="Replica Store\n[Container: SQL Data Store]\nSQLite or PostgreSQL",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  logs [
    shape=cylinder,
    label="Structured Log Files\n[Container: File Store]",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  snapshot [
    shape=cylinder,
    label="Replica Snapshot\n[Container: File]\n.ollsnap",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];

  subgraph cluster_daemon {
    label="oll Node Daemon [Container: Rust + Tokio]";
    labelloc=t;
    labeljust=l;
    fontsize=14;
    fontname="Helvetica";
    color="#438DD5";
    penwidth=2;
    style="rounded,dashed";
    margin=20;

    lifecycle [
      label="Node Lifecycle Orchestrator\n[Component]\nInterface: PreparedRunIntent, Unix signals, and ShutdownNotice.\nOwns startup order, readiness, one-replica construction, and shutdown.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    admin_api [
      label="Admin API Adapter\n[Component]\nInterface: oll.protocol.Admin gRPC service (7 RPCs).\nValidates context and translates transport requests to domain APIs.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    configuration [
      label="Configuration Runtime\n[Component]\nInterface: ConfigRuntime::load -> ResolvedNodeConfig.\nEncapsulates embedded LuaJIT, schema conversion, and path validation.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    deployment_state [
      label="Deployment State Gateway\n[Component]\nInterfaces: DeploymentLock and NodeIdentity APIs.\nEncapsulates single-instance locking, identity persistence, and runtime paths.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    replica [
      label="Replica Runtime\n[Component]\nInterface: ReplicaRuntime lifecycle, Admin-facing operations, and typed\ndocument/CRDT API. Encapsulates catalog/document Loro state, binary LWW,\nworking-tree reconciliation/projection, and snapshot coordination.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    persistence [
      label="Replica Persistence Gateway\n[Component]\nInterface: ReplicaStore API.\nHides SQL schema, SQLite/PostgreSQL selection, transactions, blobs,\ngenerations, history, and recovery markers.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    logger [
      label="Structured Logging Service\n[Component]\nInterface: NodeLogger open/emit/set_filter/flush.\nHides bounded queue, writer thread, filtering, routing, and file sinks.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];
  }

  admin_client -> admin_api [label="Calls GetStatus, Shutdown, SetLogFilter,\nInspectReplicaDocument, ListReplicaOperations,\nExportReplica, or ImportReplica\n[gRPC over UDS]"];

  lifecycle -> deployment_state [label="Acquires lock and loads identity\n[DeploymentLock / NodeIdentity APIs]"];
  deployment_state -> deployment_files [dir=both, label="flock and strict JSON I/O"];
  lifecycle -> configuration [label="Loads typed effective configuration\n[ConfigRuntime API]"];
  configuration -> deployment_files [label="Evaluates config.lua and contained modules\n[embedded LuaJIT]"];

  lifecycle -> logger [label="Opens, emits lifecycle events, and flushes\n[NodeLogger API]"];
  lifecycle -> replica [label="Starts exactly one instance and shuts it down\n[ReplicaRuntime API]"];
  lifecycle -> admin_api [label="Constructs with AdminState and serves UDS"];
  admin_api -> lifecycle [label="Requests ordered shutdown\n[ShutdownNotice watch channel]"];
  admin_api -> replica [label="Status, inspection, history, export, import\n[ReplicaRuntime API]"];
  admin_api -> logger [label="Emits RPC events and changes live filters\n[NodeLogger API]"];

  replica -> persistence [label="Loads, commits, replaces, and recovers state\n[ReplicaStore API]"];
  persistence -> sql_store [dir=both, label="Executes backend-neutral SQL operations\n[sqlx]"];
  replica -> working_tree [dir=both, label="Scans, watches, reconciles, and projects\n[notify + filesystem I/O]"];
  replica -> snapshot [dir=both, label="Streams validated import/export\n[tar + zstd]"];
  replica -> logger [label="Emits correlated replica and snapshot events\n[NodeLogger API]"];
  logger -> logs [label="Writes and flushes normalized JSON Lines"];
}

digraph C4_Bounded_Client_Components {
  graph [
    label="Bounded oll Client - C4 Component Diagram - Current Implementation",
    labelloc=t,
    labeljust=l,
    fontsize=20,
    fontname="Helvetica",
    bgcolor="white",
    pad=0.35,
    nodesep=0.7,
    ranksep=0.95,
    compound=true
  ];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9.5, margin="0.17,0.11"];
  edge [fontname="Helvetica", fontsize=8, color="#555555", fontcolor="#333333", arrowsize=0.72];

  user [
    label="Deployment User\n[Person]",
    fillcolor="#08427B",
    fontcolor="white",
    color="#052E56"
  ];
  daemon [
    label="oll Node Daemon\n[Container]\nServes the typed Admin API",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  deployment_files [
    shape=cylinder,
    label="Deployment Files\n[Container: File Store]",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  working_tree [
    shape=cylinder,
    label="Working Tree\n[Container: File System]",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];
  snapshot [
    shape=cylinder,
    label="Replica Snapshot\n[Container: File]\n.ollsnap",
    fillcolor="#438DD5",
    fontcolor="white",
    color="#2E6295"
  ];

  subgraph cluster_client {
    label="Bounded oll Client [Container: same Rust executable]";
    labelloc=t;
    labeljust=l;
    fontsize=14;
    fontname="Helvetica";
    color="#438DD5";
    penwidth=2;
    style="rounded,dashed";
    margin=20;

    cli_adapter [
      label="Command-Line Adapter\n[Component]\nInterface: Clap command schema.\nParses argv once and produces a validated CliIntent.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    intent_preparer [
      label="Intent Preparation Service\n[Component]\nInterface: CliIntent::prepare(Environment, cwd) -> PreparedCliIntent.\nResolves only the paths and dependencies required by the selected intent.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    client_app [
      label="Bounded Command Application Service\n[Component]\nInterface: node::execute(PreparedCliIntent).\nDispatches client work, owns confirmations, rendering, and exit mapping.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    admin_adapter [
      label="Admin Client Adapter\n[Component]\nInterface: typed get_status/request_shutdown/set_log_filter/replica calls.\nHides UDS connection setup, protobuf context, and request deadlines.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    bootstrap [
      label="Deployment Bootstrap and Launcher\n[Component]\nInterfaces: initialization and start operations.\nEncapsulates atomic config/identity creation, process spawn, and pingback.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];

    snapshot_reader [
      label="Local Snapshot Reader\n[Component]\nInterfaces: inspect_snapshot and verify_snapshot.\nEncapsulates streaming tar/zstd, manifest, hash, and Loro validation.",
      fillcolor="#85BBF0",
      fontcolor="#111111",
      color="#5B88B2"
    ];
  }

  user -> cli_adapter [label="Supplies argv and interactive input"];
  cli_adapter -> intent_preparer [label="Passes validated CliIntent"];
  intent_preparer -> client_app [label="Passes PreparedCliIntent"];

  client_app -> admin_adapter [label="Performs one typed operational request"];
  admin_adapter -> daemon [label="Calls Admin API\n[protobuf/gRPC over UDS]"];

  client_app -> bootstrap [label="Initializes or starts a deployment"];
  bootstrap -> deployment_files [dir=both, label="Creates/replaces files and checks lock/socket"];
  bootstrap -> working_tree [label="Creates configured root when absent"];
  bootstrap -> daemon [label="Spawns same executable and checks readiness\n[process + nonce pingback]", style=dashed];

  client_app -> snapshot_reader [label="Inspects or verifies without a daemon"];
  snapshot_reader -> snapshot [label="Reads and validates streaming archive"];
}
